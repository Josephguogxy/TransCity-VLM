{
  "bf16": {
    "enabled": true
  },
  "fp16": {
    "enabled": false
  },
  "communication_data_type": "bf16",
  "zero_optimization": {
    "stage": 2,
    "offload_optimizer": {
      "device": "none"
    },
    "allgather_partitions": true,
    "allgather_bucket_size": 200000000,
